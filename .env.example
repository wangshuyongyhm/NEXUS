# NEXUS .env template — copy is NOT needed; `nexus setup` wizard writes ~/.nexus/.env for you.
# This template documents the supported keys. Real values must NEVER be committed.

# LLM providers (fill what you use)
ZHIPU_API_KEY=          # 智谱 GLM — https://open.bigmodel.cn/usercenter/apikeys
KIMI_API_KEY=           # Kimi (Moonshot) — https://platform.moonshot.cn/console/api-keys
DEEPSEEK_API_KEY=       # DeepSeek — https://platform.deepseek.com/api_keys
OPENROUTER_API_KEY=     # optional — https://openrouter.ai/keys

# Messaging platforms (optional)
TELEGRAM_BOT_TOKEN=     # via @BotFather
FEISHU_APP_ID=          # https://open.feishu.cn/app (cli_...)
FEISHU_APP_SECRET=
